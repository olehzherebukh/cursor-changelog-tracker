# Scraper configuration
CHANGELOG_URL=https://www.cursor.com/changelog
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36
REQUEST_TIMEOUT=30

# Logging configuration
LOG_LEVEL=INFO

# Storage configuration
STORAGE_TYPE=dynamodb

# DynamoDB configuration
DYNAMODB_TABLE_NAME=cursor-changelog-versions

# SES configuration
SES_REGION=us-east-1
SES_FROM_EMAIL=cursor-changelog@yourdomain.com
SES_TO_EMAILS=["oleh.zherebukh@inoxoft.com", "ruslan.pitula@inoxoft.com"]
